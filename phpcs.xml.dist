<?xml version="1.0"?>
<ruleset name="webium/silverstripe-composer-report">
    <description>PSR-12 with strict types for webium/silverstripe-composer-report</description>

    <file>src</file>
    <file>tests/php</file>

    <arg value="sp"/>
    <arg name="colors"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.PHP.RequireStrictTypes"/>
</ruleset>
